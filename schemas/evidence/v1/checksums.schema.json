{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://change-two.dev/schemas/evidence/v1/checksums.schema.json",
  "title": "Evidence Bundle Checksum Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaType", "schemaVersion", "algorithm", "contentSetSha256", "entries"],
  "properties": {
    "schemaType": { "const": "checksums" },
    "schemaVersion": { "const": "evidence/v1" },
    "algorithm": { "const": "sha256" },
    "contentSetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "enum": ["bundle-file", "external-artifact", "revision", "checksum-manifest"] },
          "mode": { "enum": ["bytes", "self-canonical"] }
        }
      }
    }
  }
}
