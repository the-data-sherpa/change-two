{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://change-two.dev/schemas/protocol/v1/budget.schema.json",
  "title": "Budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaType",
    "budgetId",
    "version",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "schemaType": {
      "const": "budget"
    },
    "budgetId": {
      "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/version"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallClockSeconds",
        "operatorActiveSeconds",
        "reviewerActiveSeconds",
        "recoveryAttempts",
        "modelSpend"
      ],
      "properties": {
        "wallClockSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "operatorActiveSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "reviewerActiveSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "modelSpend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "maximum",
            "measurementMode"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "maximum": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "measurementMode": {
              "enum": [
                "enforced",
                "estimated",
                "observed-after-run",
                "unavailable"
              ]
            }
          }
        }
      }
    }
  }
}
