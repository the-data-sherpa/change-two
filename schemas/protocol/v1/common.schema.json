{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://change-two.dev/schemas/protocol/v1/common.schema.json",
  "title": "Change Two protocol common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?::[a-z0-9]+(?:[._-][a-z0-9]+)*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:-[a-z0-9.-]+)?$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.*\\S.*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind",
        "mediaType",
        "releaseStatus",
        "sha256"
      ],
      "properties": {
        "artifactId": {
          "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "requirement",
            "hidden-evaluation",
            "runtime-image",
            "instructions",
            "rubric",
            "policy"
          ]
        },
        "mediaType": {
          "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/nonEmpty"
        },
        "releaseStatus": {
          "enum": [
            "sealed",
            "released"
          ]
        },
        "sha256": {
          "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/sha256"
        }
      }
    },
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/version"
        }
      }
    }
  }
}
