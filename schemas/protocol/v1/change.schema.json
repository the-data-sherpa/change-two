{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://change-two.dev/schemas/protocol/v1/change.schema.json",
  "title": "Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaType",
    "changeId",
    "sequence",
    "title",
    "releaseStatus",
    "requirementSha256",
    "criterionIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "schemaType": {
      "const": "change"
    },
    "changeId": {
      "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/nonEmpty"
    },
    "releaseStatus": {
      "enum": [
        "sealed",
        "released"
      ]
    },
    "requirementSha256": {
      "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/sha256"
    },
    "criterionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://change-two.dev/schemas/protocol/v1/common.schema.json#/$defs/id"
      }
    }
  }
}
