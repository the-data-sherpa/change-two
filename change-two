#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

set -a
# shellcheck disable=SC1091
. "$ROOT/toolchain.env"
set +a

usage() {
  cat <<'USAGE'
Usage:
  ./change-two bootstrap
  ./change-two starter up|down|status|logs|migrate|seed
  ./change-two protocol validate|validate-matrix <document.json>
  ./change-two protocol check-fixtures
  ./change-two evidence materialize <capture.jsonl> <bundle-dir>
  ./change-two evidence replay <capture.jsonl> <bundle-dir>
  ./change-two evidence verify <bundle-dir>
  ./change-two evidence correct <capture.jsonl> <previous-bundle-dir> <new-bundle-dir> <correction.json>
  ./change-two check
  ./change-two package starter-api|starter-web|protocol|evidence build|typecheck|test
  ./change-two verify starter|starter-http|starter-browser|reproducible-build
USAGE
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required but was not found." >&2
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "The Docker daemon is not available." >&2
    exit 1
  fi
}

run_workspace() {
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env COREPACK_HOME=/tmp/corepack \
    --env HOME=/tmp \
    --volume "$ROOT:/workspace" \
    --workdir /workspace \
    "$NODE_IMAGE" \
    corepack pnpm "$@"
}

compose() {
  docker compose --env-file "$ROOT/toolchain.env" "$@"
}

bootstrap() {
  require_docker
  run_workspace install --frozen-lockfile
}

starter() {
  require_docker
  case "${1:-}" in
    up)
      compose up --build --detach --wait
      printf 'Starter web: http://localhost:%s\n' "${WEB_PORT:-4173}"
      printf 'Starter API: http://localhost:%s/health\n' "${API_PORT:-4300}"
      ;;
    migrate)
      compose run --build --rm migrate
      ;;
    seed)
      compose run --build --rm seed
      ;;
    down)
      compose down --remove-orphans
      ;;
    status)
      compose ps
      ;;
    logs)
      compose logs --follow
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

check_workspace() {
  require_docker
  docker build \
    --file docker/workspace.Dockerfile \
    --target checked \
    --build-arg "NODE_IMAGE=$NODE_IMAGE" \
    --build-arg "PNPM_VERSION=$PNPM_VERSION" \
    .
}

package_diagnostic() {
  require_docker
  local workspace=${1:-}
  local script=${2:-}

  case "$workspace" in
    evidence|protocol|starter-api|starter-web) ;;
    *)
      usage
      exit 2
      ;;
  esac

  case "$script" in
    build|test|typecheck) ;;
    *)
      usage
      exit 2
      ;;
  esac

  run_workspace --filter "@change-two/$workspace" run "$script"
}

protocol() {
  require_docker
  run_workspace --silent --filter "@change-two/protocol" exec tsx src/cli.ts "$@"
}

evidence() {
  require_docker
  run_workspace --silent --filter "@change-two/evidence" exec tsx src/cli.ts "$@"
}

verify_starter() {
  require_docker
  local result=0

  if ! compose up --build --detach --wait; then
    result=1
  else
    if ! compose exec -T api node -e \
      "fetch('http://127.0.0.1:3000/health').then(async r=>{const b=await r.json();if(r.status!==200||b.status!=='ok'||b.service!=='starter-api')process.exit(1)}).catch(()=>process.exit(1))"; then
      result=1
    fi
    if ! compose exec -T api node -e \
      "fetch('http://127.0.0.1:3000/conversations').then(r=>{if(r.status!==404)process.exit(1)}).catch(()=>process.exit(1))"; then
      result=1
    fi
    if ! compose exec -T web node -e \
      "fetch('http://127.0.0.1:4173').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"; then
      result=1
    fi
    if ! compose exec -T postgres psql \
      --username change_two \
      --dbname change_two \
      --tuples-only \
      --command "SELECT 1;" >/dev/null; then
      result=1
    fi
  fi

  compose down --remove-orphans

  if [[ $result -ne 0 ]]; then
    echo "Starter verification failed." >&2
    return "$result"
  fi

  echo "Starter web, API, empty feature surface, and PostgreSQL are healthy."
}

verify_starter_http() {
  require_docker
  local result=0

  if ! compose up --detach --wait postgres; then
    result=1
  elif ! compose run --build --rm migrate; then
    result=1
  elif ! compose run --build --rm --no-deps api \
    pnpm --filter "@change-two/starter-api" test:http; then
    result=1
  fi

  compose down --remove-orphans
  if [[ $result -ne 0 ]]; then
    echo "Starter HTTP verification failed." >&2
    return "$result"
  fi
  echo "Starter HTTP session, seed, and tenant-authority checks passed."
}

verify_starter_browser() {
  require_docker
  local result=0
  local image=change-two-browser:local

  if ! compose up --build --detach --wait; then
    result=1
  elif ! docker build \
    --file docker/workspace.Dockerfile \
    --target browser \
    --tag "$image" \
    --build-arg "NODE_IMAGE=$NODE_IMAGE" \
    --build-arg "PNPM_VERSION=$PNPM_VERSION" \
    .; then
    result=1
  elif ! docker run --rm \
    --network host \
    --env "STARTER_WEB_URL=http://localhost:${WEB_PORT:-4173}" \
    "$image" \
    pnpm --filter "@change-two/starter-web" test:browser; then
    result=1
  fi

  compose down --remove-orphans
  if [[ $result -ne 0 ]]; then
    echo "Starter browser verification failed." >&2
    return "$result"
  fi
  echo "Starter browser identity and Organization checks passed."
}

verify_reproducible_build() {
  require_docker
  local temp
  temp=$(mktemp -d)
  trap 'rm -rf "$temp"' RETURN

  for output in first second; do
    docker build \
      --no-cache \
      --file docker/workspace.Dockerfile \
      --target artifacts \
      --output "type=local,dest=$temp/$output" \
      --build-arg "NODE_IMAGE=$NODE_IMAGE" \
      --build-arg "PNPM_VERSION=$PNPM_VERSION" \
      .
  done

  if ! diff --recursive --brief "$temp/first" "$temp/second"; then
    echo "Clean builds produced different application artifacts." >&2
    exit 1
  fi

  echo "Clean builds produced identical application artifacts."
}

case "${1:-}" in
  bootstrap)
    shift
    [[ $# -eq 0 ]] || { usage; exit 2; }
    bootstrap
    ;;
  starter)
    shift
    starter "$@"
    ;;
  check)
    shift
    [[ $# -eq 0 ]] || { usage; exit 2; }
    check_workspace
    ;;
  package)
    shift
    package_diagnostic "$@"
    ;;
  protocol)
    shift
    protocol "$@"
    ;;
  evidence)
    shift
    evidence "$@"
    ;;
  verify)
    shift
    case "${1:-}" in
      reproducible-build) verify_reproducible_build ;;
      starter) verify_starter ;;
      starter-browser) verify_starter_browser ;;
      starter-http) verify_starter_http ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *)
    usage
    exit 2
    ;;
esac
