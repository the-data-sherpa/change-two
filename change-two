#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

set -a
# shellcheck disable=SC1091
. "$ROOT/toolchain.env"
set +a

usage() {
  cat <<'USAGE'
Usage:
  ./change-two bootstrap
  ./change-two starter up|down|status|logs|migrate|seed
  ./change-two protocol validate|validate-matrix <document.json>
  ./change-two protocol check-fixtures
  ./change-two evidence materialize <capture.jsonl> <bundle-dir>
  ./change-two evidence replay <capture.jsonl> <bundle-dir>
  ./change-two evidence verify <bundle-dir>
  ./change-two evidence correct <capture.jsonl> <previous-bundle-dir> <new-bundle-dir> <correction.json>
  ./change-two verification execute <workspace> <check-bundle-dir> <output.json>
  ./change-two runner execute <plan.json> <output-dir>
  ./change-two practice execute <plan.json> <output-dir>
  ./change-two runner timer-start|timer-stop|timer-correct|intervene ...
  ./change-two sanitizer scan <bundle-dir> <policy.json> <scan.json>
  ./change-two sanitizer sanitize <bundle-dir> <publication-dir> <policy.json> <request.json>
  ./change-two sanitizer approve <publication-dir> <approval.json>
  ./change-two sanitizer retention <publication-dir> <source-bundle-dir> <event.json>
  ./change-two site build [publication-dir]
  ./change-two check
  ./change-two package starter-api|starter-web|results|protocol|evidence|runner|sanitizer build|typecheck|test
  ./change-two verify runner|starter|starter-http|starter-browser|reproducible-build
USAGE
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required but was not found." >&2
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "The Docker daemon is not available." >&2
    exit 1
  fi
}

run_workspace() {
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env COREPACK_HOME=/tmp/corepack \
    --env HOME=/tmp \
    --volume "$ROOT:/workspace" \
    --workdir /workspace \
    "$NODE_IMAGE" \
    corepack pnpm "$@"
}
run_pinned_node() {
  local temp container status
  temp=$(mktemp -d)
  container=$(docker create "$NODE_IMAGE")
  docker cp "$container:/usr/local/bin/node" "$temp/node"
  status=0
  "$temp/node" "$@" || status=$?
  docker rm -f "$container" >/dev/null 2>&1 || true
  rm -rf "$temp"
  return "$status"
}


compose() {
  docker compose --env-file "$ROOT/toolchain.env" "$@"
}

bootstrap() {
  require_docker
  run_workspace install --frozen-lockfile
}

starter() {
  require_docker
  case "${1:-}" in
    up)
      compose up --build --detach --wait
      printf 'Starter web: http://localhost:%s\n' "${WEB_PORT:-4173}"
      printf 'Starter API: http://localhost:%s/health\n' "${API_PORT:-4300}"
      ;;
    migrate)
      compose run --build --rm migrate
      ;;
    seed)
      compose run --build --rm seed
      ;;
    down)
      compose down --remove-orphans
      ;;
    status)
      compose ps
      ;;
    logs)
      compose logs --follow
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

check_workspace() {
  require_docker
  docker build \
    --file docker/workspace.Dockerfile \
    --target checked \
    --build-arg "NODE_IMAGE=$NODE_IMAGE" \
    --build-arg "PNPM_VERSION=$PNPM_VERSION" \
    .
}

package_diagnostic() {
  require_docker
  local workspace=${1:-}
  local script=${2:-}

  case "$workspace" in
    evidence|protocol|runner|sanitizer|results|starter-api|starter-web) ;;
    *)
      usage
      exit 2
      ;;
  esac

  case "$script" in
    build|test|typecheck) ;;
    *)
      usage
      exit 2
      ;;
  esac

  run_workspace --filter "@change-two/$workspace" run "$script"
}

protocol() {
  require_docker
  run_workspace --silent --filter "@change-two/protocol" exec tsx src/cli.ts "$@"
}

evidence() {
  require_docker
  run_workspace --silent --filter "@change-two/evidence" exec tsx src/cli.ts "$@"
}

sanitizer() {
  require_docker
  run_workspace --silent --filter "@change-two/sanitizer" exec tsx src/cli.ts "$@"
}

site() {
  require_docker
  [[ "${1:-}" == "build" ]] || { usage; exit 2; }
  [[ $# -le 2 ]] || { usage; exit 2; }

  if [[ $# -eq 1 ]]; then
    run_workspace --filter "@change-two/results" run build
    return
  fi

  local publications
  publications=$(realpath -- "$2")
  [[ -d "$publications" ]] || { echo "Publication input is not a directory: $2" >&2; exit 2; }
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env COREPACK_HOME=/tmp/corepack \
    --env HOME=/tmp \
    --env RESULTS_PUBLICATIONS_DIR=/publications \
    --volume "$ROOT:/workspace" \
    --volume "$publications:/publications:ro" \
    --workdir /workspace \
    "$NODE_IMAGE" \
    corepack pnpm --filter "@change-two/results" run build
}

practice() {
  require_docker
  [[ "${1:-}" == "execute" && $# -eq 3 ]] || { usage; exit 2; }

  local secret_file=${CHANGE_TWO_ANTHROPIC_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/change-two/secrets/anthropic-api-key}
  [[ -f "$secret_file" && -r "$secret_file" ]] || {
    echo "Practice credential file is missing or unreadable: $secret_file" >&2
    exit 1
  }
  [[ "$(stat -c '%u' "$secret_file")" == "$(id -u)" && "$(stat -c '%a' "$secret_file")" == "600" ]] || {
    echo "Practice credential file must be owned by the current user with mode 0600: $secret_file" >&2
    exit 1
  }

  ANTHROPIC_API_KEY=$(<"$secret_file")
  export ANTHROPIC_API_KEY
  [[ "$ANTHROPIC_API_KEY" == sk-ant-* ]] || {
    unset ANTHROPIC_API_KEY
    echo "Practice credential does not have the expected Anthropic key prefix." >&2
    exit 1
  }
  runner execute "$2" "$3"
  unset ANTHROPIC_API_KEY
}

runner() {
  require_docker
  run_pinned_node --import ./packages/runner/node_modules/tsx/dist/loader.mjs packages/runner/src/cli.ts "$@"
}

verification() {
  require_docker
  [[ "${1:-}" == "execute" && $# -eq 4 ]] || { usage; exit 2; }
  run_pinned_node --import ./packages/runner/node_modules/tsx/dist/loader.mjs \
    packages/runner/src/cli.ts verification-execute "$2" "$3" "$4" "$ROOT"
}

verify_starter() {
  require_docker
  local result=0

  if ! compose up --build --detach --wait; then
    result=1
  else
    if ! compose exec -T api node -e \
      "fetch('http://127.0.0.1:3000/health').then(async r=>{const b=await r.json();if(r.status!==200||b.status!=='ok'||b.service!=='starter-api')process.exit(1)}).catch(()=>process.exit(1))"; then
      result=1
    fi
    if ! compose exec -T api node -e \
      "fetch('http://127.0.0.1:3000/conversations').then(r=>{if(r.status!==404)process.exit(1)}).catch(()=>process.exit(1))"; then
      result=1
    fi
    if ! compose exec -T web node -e \
      "fetch('http://127.0.0.1:4173').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"; then
      result=1
    fi
    if ! compose exec -T postgres psql \
      --username change_two \
      --dbname change_two \
      --tuples-only \
      --command "SELECT 1;" >/dev/null; then
      result=1
    fi
  fi

  compose down --remove-orphans

  if [[ $result -ne 0 ]]; then
    echo "Starter verification failed." >&2
    return "$result"
  fi

  echo "Starter web, API, empty feature surface, and PostgreSQL are healthy."
}

verify_starter_http() {
  require_docker
  local result=0

  if ! compose up --detach --wait postgres; then
    result=1
  elif ! compose run --build --rm migrate; then
    result=1
  elif ! compose run --build --rm --no-deps api \
    pnpm --filter "@change-two/starter-api" test:http; then
    result=1
  fi

  compose down --remove-orphans
  if [[ $result -ne 0 ]]; then
    echo "Starter HTTP verification failed." >&2
    return "$result"
  fi
  echo "Starter HTTP session, seed, and tenant-authority checks passed."
}

verify_starter_browser() {
  require_docker
  local result=0
  local image=change-two-browser:local

  if ! compose up --build --detach --wait; then
    result=1
  elif ! docker build \
    --file docker/workspace.Dockerfile \
    --target browser \
    --tag "$image" \
    --build-arg "NODE_IMAGE=$NODE_IMAGE" \
    --build-arg "PNPM_VERSION=$PNPM_VERSION" \
    .; then
    result=1
  elif ! docker run --rm \
    --network host \
    --env "STARTER_WEB_URL=http://localhost:${WEB_PORT:-4173}" \
    "$image" \
    pnpm --filter "@change-two/starter-web" test:browser; then
    result=1
  fi

  compose down --remove-orphans
  if [[ $result -ne 0 ]]; then
    echo "Starter browser verification failed." >&2
    return "$result"
  fi
  echo "Starter browser identity and Organization checks passed."
}

verify_reproducible_build() {
  require_docker
  local temp
  temp=$(mktemp -d)
  trap 'rm -rf "$temp"' RETURN

  for output in first second; do
    docker build \
      --no-cache \
      --file docker/workspace.Dockerfile \
      --target artifacts \
      --output "type=local,dest=$temp/$output" \
      --build-arg "NODE_IMAGE=$NODE_IMAGE" \
      --build-arg "PNPM_VERSION=$PNPM_VERSION" \
      .
  done

  if ! diff --recursive --brief "$temp/first" "$temp/second"; then
    echo "Clean builds produced different application artifacts." >&2
    exit 1
  fi

  echo "Clean builds produced identical application artifacts."
}

verify_runner() {
  require_docker
  run_pinned_node --import ./packages/runner/node_modules/tsx/dist/loader.mjs --test packages/runner/test/*.test.ts
}

case "${1:-}" in
  bootstrap)
    shift
    [[ $# -eq 0 ]] || { usage; exit 2; }
    bootstrap
    ;;
  starter)
    shift
    starter "$@"
    ;;
  check)
    shift
    [[ $# -eq 0 ]] || { usage; exit 2; }
    check_workspace
    ;;
  package)
    shift
    package_diagnostic "$@"
    ;;
  protocol)
    shift
    protocol "$@"
    ;;
  evidence)
    shift
    evidence "$@"
    ;;
  sanitizer)
    shift
    sanitizer "$@"
    ;;
  site)
    shift
    site "$@"
    ;;
  practice)
    shift
    practice "$@"
    ;;
  runner)
    shift
    runner "$@"
    ;;
  verification)
    shift
    verification "$@"
    ;;
  verify)
    shift
    case "${1:-}" in
      reproducible-build) verify_reproducible_build ;;
      starter) verify_starter ;;
      starter-browser) verify_starter_browser ;;
      starter-http) verify_starter_http ;;
      runner) verify_runner ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *)
    usage
    exit 2
    ;;
esac
