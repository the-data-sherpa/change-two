{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "types": ["astro/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*.astro", "src/**/*.ts", "test/**/*.ts", "playwright.config.ts"]
}
